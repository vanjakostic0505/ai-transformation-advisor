{
  "name": "ai-transformation-advisor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive prototype: AI Transformation Advisor — a strategy-to-execution layer above Smooth Operator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --pretty",
    "verify": "esbuild tests/journey.test.tsx --bundle --platform=node --format=esm --outfile=node_modules/.tmp/journey.mjs --loader:.css=empty --external:jsdom --external:@testing-library/react --external:react --external:react-dom --external:react/jsx-runtime --jsx=automatic --log-level=error && node node_modules/.tmp/journey.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
